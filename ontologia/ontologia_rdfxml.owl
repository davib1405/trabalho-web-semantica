  <rdf:Description rdf:about="http://dados.ufrrj.br/ontologia/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="pt">Ontologia de Perfis Acadêmicos da UFRRJ</dcterms:title>
    <dcterms:description xml:lang="pt">Ontologia de aplicação desenvolvida para modelagem, publicação e interligação semântica de perfis de docentes e discentes universitários no contexto de Linked Open Data.</dcterms:description>
    <dcterms:creator>David Barros da Rosa Filho</dcterms:creator>
    <dcterms:publisher>Universidade Federal Rural do Rio de Janeiro - Departamento de Computação</dcterms:publisher>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>
